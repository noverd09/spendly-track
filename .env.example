# Supabase project settings → API. The publishable key is safe for the browser;
# never put the secret / service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: canonical site URL, used for metadata and as a fallback for
# auth email redirects (e.g. https://spendly.vercel.app).
NEXT_PUBLIC_SITE_URL=
